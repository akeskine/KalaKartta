<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/sessionTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kalastussessio"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/durationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kesto: -"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/distanceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Matka: -"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/trackPointsText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reittipisteitä: -"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kalastaja"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <EditText
            android:id="@+id/fishermanInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kalastajan nimi"
            android:inputType="textPersonName"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Muistiinpanot"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary" />

        <EditText
            android:id="@+id/notesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kirjoita muistiinpanot tähän..."
            android:inputType="textMultiLine"
            android:gravity="top"
            android:minLines="5"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <TextView
                android:id="@+id/saveLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tallenna"
                android:textColor="@color/link_color"
                android:textSize="18sp"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/backLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Takaisin"
                android:textColor="@color/link_color"
                android:textSize="18sp"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
