<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/mapCrosshair"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/plus"
        android:textSize="32sp"
        android:textStyle="bold"
        android:elevation="8dp" />

    <LinearLayout
        android:id="@+id/recordingStatusLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="32dp"
        android:layout_marginStart="8dp"
        android:background="#80000000"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <View
            android:id="@+id/recordingDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/default_point"
            android:backgroundTint="#FF0000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="REC"
            android:textColor="#FF0000"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
    
    <FrameLayout
        android:id="@+id/replayPlayerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="@dimen/replay_player_margin_bottom"
        android:layout_marginEnd="@dimen/replay_player_margin_end"
        android:paddingStart="16dp"
        android:paddingEnd="0dp"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:id="@+id/replayPlayerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#CC000000"
            android:orientation="vertical"
            android:padding="12dp"
            android:elevation="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/replayPlayPauseButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_media_pause"
                    app:tint="@color/white"
                    tools:ignore="ContentDescription" />

                <SeekBar
                    android:id="@+id/replaySeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <Spinner
                    android:id="@+id/replaySpeedSpinner"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:padding="0dp"
                    android:minWidth="0dp"
                    android:dropDownWidth="wrap_content" />

                <ImageButton
                    android:id="@+id/replayMinimizeButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="@color/white"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

            <TextView
                android:id="@+id/replayTimeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:textColor="@color/white"
                android:textSize="12sp"
                tools:text="12:30 / 14:00" />

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/replayRestoreButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="Restore Replay UI"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:visibility="gone"
            android:elevation="11dp"
            app:backgroundTint="#CC000000"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="32dp"
            app:iconTint="@color/white"
            app:rippleColor="@android:color/transparent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.KalaKartta.Rounded"
            app:strokeColor="@color/white"
            app:strokeWidth="1dp" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KalaKartta"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="#80000000"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/weatherStationText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:background="#80000000"
            android:paddingHorizontal="6dp"
            android:paddingVertical="1dp"
            android:visibility="gone"
            tools:text="Säätiedot: Helsinki Kaisaniemi" />

        <LinearLayout
            android:id="@+id/filterStatusLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#80000000"
            android:padding="8dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/white"
                tools:ignore="ContentDescription" />

            <fi.anssi.kalakartta.ui.WindDirectionView
                android:id="@+id/filterWindView"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="4dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/filterStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:textColor="@color/white"
                android:textSize="14sp"
                tools:text="Ahven 1.1.-31.3." />
        </LinearLayout>
    </LinearLayout>
    
    <LinearLayout
        android:id="@+id/measurementLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="60dp"
        android:background="#80000000"
        android:padding="8dp"
        android:orientation="horizontal"
        android:visibility="gone">
        <TextView
            android:id="@+id/measurementText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="14sp"
            tools:text="Etäisyys 391 m." />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/myLocationButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginBottom="@dimen/button_margin_bottom"
        android:contentDescription="@string/my_location"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:visibility="gone"
        app:backgroundTint="@android:color/transparent"
        app:icon="@android:drawable/ic_menu_mylocation"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="32dp"
        app:iconTint="@color/white"
        app:rippleColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.KalaKartta.Rounded"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addCatchButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/side_margin"
        android:layout_marginBottom="@dimen/button_margin_bottom"
        android:contentDescription="@string/add_catch_short"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="48dp"
        app:iconTint="@color/white"
        app:rippleColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.KalaKartta.Rounded"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp" />

    <TextView
        android:id="@+id/defaultFishermanText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/side_margin"
        android:layout_marginBottom="50dp"
        android:textSize="12sp"
        android:textColor="@color/white"
        android:visibility="gone"
        tools:text="Esa"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settingsButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="@dimen/settings_button_margin_top"
        android:layout_marginStart="@dimen/side_margin"
        android:contentDescription="@string/settings"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_menu"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="32dp"
        app:iconTint="@color/white"
        app:rippleColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.KalaKartta.Rounded"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/quickMapSourceButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="150dp"
        android:layout_marginStart="@dimen/side_margin"
        android:contentDescription="@string/quick_map_source"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:visibility="gone"
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_map"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:iconTint="@color/white"
        app:rippleColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.KalaKartta.Rounded"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/heatmapShortcutButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="220dp"
        android:layout_marginStart="@dimen/side_margin"
        android:contentDescription="Heatmap päälle/pois"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:visibility="gone"
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_heatmap"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:iconTint="@color/white"
        app:rippleColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.KalaKartta.Rounded"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/measurementButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/settings_button_margin_top"
        android:layout_marginEnd="@dimen/side_margin"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:visibility="gone"
        app:backgroundTint="@android:color/transparent"
        app:icon="@android:drawable/ic_menu_compass"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="32dp"
        app:iconTint="@color/white"
        app:rippleColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.KalaKartta.Rounded"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/undoMeasurementButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="@dimen/side_margin"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:visibility="gone"
        app:backgroundTint="@android:color/transparent"
        app:icon="@android:drawable/ic_menu_revert"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="24dp"
        app:iconTint="@color/white"
        app:rippleColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.KalaKartta.Rounded"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp" />

    <LinearLayout
        android:id="@+id/selectionModeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="48dp"
        android:background="#CC000000"
        android:orientation="horizontal"
        android:padding="16dp"
        android:visibility="gone"
        tools:visibility="visible">

        <Button
            android:id="@+id/cancelSelectionButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Peru"
            android:textColor="@color/white"
            app:strokeColor="@color/white" />

        <Button
            android:id="@+id/confirmSelectionButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:text="Rajaa valittu alue" />
    </LinearLayout>

</FrameLayout>