<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/mapCrosshair"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="+"
        android:textSize="32sp"
        android:textStyle="bold"
        android:elevation="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/myLocationButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/side_margin"
        android:layout_marginBottom="@dimen/button_margin_bottom"
        android:contentDescription="Oma sijainti"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        android:visibility="gone"
        app:backgroundTint="@android:color/transparent"
        app:icon="@android:drawable/ic_menu_mylocation"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="32dp"
        app:iconTint="@color/white"
        app:rippleColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.KalaKartta.Rounded"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/addCatchButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/side_margin"
        android:layout_marginBottom="@dimen/button_margin_bottom"
        android:contentDescription="Lisää kala"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:backgroundTint="@android:color/transparent"
        app:icon="@drawable/ic_add"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="48dp"
        app:iconTint="@color/white"
        app:rippleColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.KalaKartta.Rounded"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settingsButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="@dimen/settings_button_margin_top"
        android:layout_marginStart="@dimen/side_margin"
        android:contentDescription="Asetukset"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:padding="0dp"
        app:backgroundTint="@android:color/transparent"
        app:icon="@android:drawable/ic_menu_manage"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="32dp"
        app:iconTint="@color/white"
        app:rippleColor="@android:color/transparent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.KalaKartta.Rounded"
        app:strokeColor="@color/white"
        app:strokeWidth="1dp" />

</FrameLayout>