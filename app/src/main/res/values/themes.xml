<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.KalaKartta" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="colorPrimary">#6200EE</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="editTextStyle">@style/Widget.AppCompat.EditText</item>
        <item name="android:spinnerStyle">@style/Widget.AppCompat.Spinner</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.KalaKartta.Dialog.Alert</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.KalaKartta.MaterialAlertDialog</item>
        <item name="android:datePickerDialogTheme">@style/ThemeOverlay.KalaKartta.Dialog.Alert</item>
        <item name="android:timePickerDialogTheme">@style/ThemeOverlay.KalaKartta.Dialog.Alert</item>
    </style>

    <style name="Theme.KalaKartta" parent="Base.Theme.KalaKartta" />

    <style name="ShapeAppearance.KalaKartta.Rounded" parent="">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ThemeOverlay.KalaKartta.Dialog.Alert" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@drawable/kala_dialog_background</item>
    </style>

    <style name="ThemeOverlay.KalaKartta.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.KalaKartta.Dialog</item>
    </style>

    <style name="ShapeAppearanceOverlay.KalaKartta.Dialog" parent="">
        <item name="cornerSize">28dp</item>
    </style>
</resources>
